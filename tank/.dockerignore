# Default-deny context: only source/build inputs enter the daemon.
**
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!pkg/
!pkg/**
!sdk-ts/
sdk-ts/**
!sdk-ts/package.json
!sdk-ts/package-lock.json
!sdk-ts/tsconfig.json
!sdk-ts/src/
!sdk-ts/src/**
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/next.config.ts
!frontend/tsconfig.json
!frontend/postcss.config.mjs
!frontend/scripts/
frontend/scripts/**
!frontend/scripts/check-runtime.mjs
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
# Defense in depth even inside allowed source directories.
**/.env*
**/node_modules
**/.next
**/dist
**/out
**/*.tsbuildinfo
**/*.before-*
**/*.log
**/*.pid
**/*.sqlite*
**/*.db
**/*.keystore
**/*.pem
**/*.key
**/*.tank-key.json
**/*-credential.json
**/*.credential.json
**/secrets
**/data
**/*_test.go
