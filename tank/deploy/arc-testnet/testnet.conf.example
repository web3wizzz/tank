# Reference template only. Put actual configuration in private local files.
# Explicit testnet broadcasting is authorized only after guarded preflight passes.
TANK_ARC_TESTNET_RPC=REPLACE_WITH_SELECTED_HTTPS_RPC_ENDPOINT
TANK_ARC_TESTNET_SENDER=REPLACE_WITH_PUBLIC_SIGNER_ADDRESS
TANK_ARC_TESTNET_ACCOUNT=REPLACE_WITH_NAMED_ENCRYPTED_KEYSTORE_ACCOUNT
TANK_ARC_TESTNET_MAX_GAS=1000000
TANK_ARC_TESTNET_CONFIRMATIONS=1
TANK_CHAIN_ID=5042002
# Native USDC base units, not ERC-20 micro-USDC; explicit operator ceilings.
TANK_ARC_TESTNET_MAX_FEE=65000000000
TANK_ARC_TESTNET_MAX_TIP=1000000000
# Per registration: 0.008 native testnet USDC. Do not copy the deployment cap here.
TANK_ARC_TESTNET_MAX_COST=8000000000000000
# Default registration mode is preparation; --broadcast opts into guarded submission.
TANK_REGISTRY_ADDR=REPLACE_WITH_VERIFIED_TESTNET_REGISTRY_ADDRESS
TANK_DATABASE_PATH=REPLACE_WITH_PRIVATE_METADATA_DATABASE_PATH
TANK_SIGNER_KEYSTORE_FILE=REPLACE_WITH_PRIVATE_ENCRYPTED_V3_KEYSTORE_PATH
TANK_SIGNER_PASSWORD_FILE=REPLACE_WITH_PRIVATE_PASSWORD_FILE_PATH

# Separate deployment and durable aggregate registration fee budgets (18 decimals).
TANK_ARC_DEPLOY_MAX_GAS=1000000
TANK_ARC_DEPLOY_MAX_FEE=65000000000
TANK_ARC_DEPLOY_MAX_TIP=1000000000
TANK_ARC_DEPLOY_MAX_COST=40000000000000000
TANK_ARC_TESTNET_TOTAL_BUDGET=100000000000000000
TANK_ARC_DEPLOY_ARTIFACT=REPLACE_WITH_COMPILED_TANKREGISTRY_ARTIFACT_PATH
TANK_ARC_DEPLOY_JOURNAL=REPLACE_WITH_PRIVATE_DEDICATED_DEPLOYMENT_JOURNAL_PATH
# Coordinator public status mode; custody/RPC remain with the separate worker.
TANK_REGISTRATION_MODE=arc-testnet-external
