FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55 AS build
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/install-arc-foundry.sh /tmp/install-tools.sh
RUN bash /tmp/install-tools.sh /tools
COPY contracts/foundry.toml /contract/foundry.toml
COPY contracts/src/ /contract/src/
RUN /tools/arc-forge build --root /contract \
    && /tools/arc-forge inspect --root /contract TankRegistry bytecode > /contract/creation.txt \
    && /tools/arc-forge inspect --root /contract TankRegistry deployedBytecode > /contract/runtime.txt

# This image is a private, loopback-only fixture, never an Arc public signer.
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55 AS runtime
COPY --from=build /tools/arc-anvil /tools/arc-cast /usr/local/bin/
COPY --from=build /contract/creation.txt /contract/runtime.txt /fixture/
COPY --chmod=755 deploy/container/run-local-chain.sh /usr/local/bin/run-local-chain
RUN apt-get update && apt-get install -y --no-install-recommends libgcc-s1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 tank && useradd -u 10001 -g tank -M -s /usr/sbin/nologin tank \
    && mkdir -p /chain && chown tank:tank /chain && chmod 0700 /chain \
    && chmod 0755 /usr/local/bin/arc-anvil /usr/local/bin/arc-cast
USER 10001:10001
CMD ["run-local-chain"]
