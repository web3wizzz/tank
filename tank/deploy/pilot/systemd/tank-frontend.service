[Unit]
Description=Tank encrypted browser workspace
After=network-online.target tank-coordinator.service
Wants=network-online.target

[Service]
Type=simple
User=tank
Group=tank
UMask=0077
EnvironmentFile=/etc/tank/frontend.conf
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
WorkingDirectory=/opt/tank/frontend
ExecStart=/usr/bin/node /opt/tank/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=tank-frontend
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tank-frontend /opt/tank/frontend/.next/cache

[Install]
WantedBy=multi-user.target
