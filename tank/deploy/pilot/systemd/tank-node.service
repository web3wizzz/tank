[Unit]
Description=Tank pilot storage node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tank
Group=tank
UMask=0077
EnvironmentFile=/etc/tank/node.conf
ExecStart=/opt/tank/bin/tank-node
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=tank-node
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tank-node

[Install]
WantedBy=multi-user.target
