# Install as /etc/tank/coordinator.conf, owner root:tank, mode 0640.
TANK_COORDINATOR_ADDR=127.0.0.1:8080
TANK_DATABASE_PATH=/var/lib/tank-coordinator/tank.sqlite
TANK_NODES=REPLACE_NODE_1_HTTPS_URL,REPLACE_NODE_2_HTTPS_URL,REPLACE_NODE_3_HTTPS_URL,REPLACE_NODE_4_HTTPS_URL
TANK_NODE_CREDENTIALS_FILE=/etc/tank/node-credentials.json
TANK_API_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_ADMIN_TOKEN
TANK_MAX_FILE_BYTES=16777216
TANK_MAX_SEGMENT_BYTES=4194304
TANK_MAX_CONCURRENT_REQUESTS=4
TANK_MAX_CONCURRENT_PER_USER=2
TANK_MAX_CONNECTIONS=64
TANK_REQUESTS_PER_MINUTE=300
TANK_REQUEST_BURST=60
TANK_USER_STORAGE_BYTES=1073741824
TANK_TOTAL_STORAGE_BYTES=10737418240
TANK_REQUEST_TIMEOUT_SECONDS=120
# Testnet registration stays disabled until the signed-worker milestone is ready.
