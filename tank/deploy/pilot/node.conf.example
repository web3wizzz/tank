# Use this template independently on each of four selected machines.
# Install as /etc/tank/node.conf, owner root:tank, mode 0640.
TANK_NODE_ADDR=127.0.0.1:9101
TANK_NODE_DATA_DIR=/var/lib/tank-node/shards
TANK_NODE_TOKEN=REPLACE_WITH_THIS_NODES_PRIVATE_RANDOM_TOKEN
TANK_NODE_STORAGE_BYTES=10737418240
TANK_NODE_MAX_FILES=100000
TANK_NODE_MAX_CONNECTIONS=64
TANK_NODE_MAX_CONCURRENT_REQUESTS=16
TANK_REQUEST_TIMEOUT_SECONDS=120
