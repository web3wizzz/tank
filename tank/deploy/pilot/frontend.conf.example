# Exact HTTPS origin, without path or trailing slash. Choose the real host later.
TANK_FRONTEND_ORIGIN=REPLACE_EXACT_FRONTEND_HTTPS_ORIGIN
TANK_API_URL=REPLACE_COORDINATOR_HTTPS_URL
TANK_SESSION_SECRET=REPLACE_WITH_PRIVATE_RANDOM_64_HEX_SECRET
TANK_MAX_FILE_BYTES=16777216
TANK_FRONTEND_MAX_CONCURRENT_REQUESTS=8
TANK_REQUEST_TIMEOUT_SECONDS=120
# No administrator or node token belongs in this frontend environment.
